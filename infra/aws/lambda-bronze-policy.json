{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "LerLakehouse",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::flutter-martech-lakehouse",
                "arn:aws:s3:::flutter-martech-lakehouse/*"
            ]
        },
        {
            "Sid": "EscreverCamadasDerivadas",
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::flutter-martech-lakehouse/*"
        },
        {
            "Sid": "BronzeImutavel",
            "Effect": "Deny",
            "Action": [
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::flutter-martech-lakehouse/bronze/*"
        }
    ]
}
